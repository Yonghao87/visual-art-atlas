---
import type { Category } from '../constants/taxonomy';

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<span class="category-glyph" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    {category === 'world_painting' && (
      <>
        <rect x="4.5" y="5" width="23" height="22" rx="1" />
        <circle cx="20.5" cy="11" r="2.5" />
        <path d="m6 22 6-6 4 4 3-3 7 7M8 9h5" />
      </>
    )}
    {category === 'eastern_art' && (
      <>
        <path d="M6 8c5-4 6 5 11 1s5-4 9-2M5 15c4-3 7 4 12 0s6-4 10-1M7 23c4-4 7 3 11 0s5-3 8-1" />
        <path d="M9 27h14" />
      </>
    )}
    {category === 'digital_art' && (
      <>
        <rect x="5" y="4.5" width="22" height="23" rx="2" />
        <path d="m11 19 2.2-5.2L22 7l3 3-6.8 8.8L13 21l-2-.5.5-1.5ZM19 10l3 3M13.5 14.5l3 3" />
        <path d="M13 24h6" />
      </>
    )}
    {category === 'graphic_design' && (
      <>
        <path d="M5 7h22M5 12h11M5 17h8M5 22h22M5 27h13" />
        <circle cx="23" cy="14.5" r="3.5" />
      </>
    )}
    {category === 'architecture' && (
      <>
        <path d="M4 12 16 5l12 7M6 12h20M7 26h18M9 13v12M14 13v12M19 13v12M24 13v12" />
        <path d="M4 28h24" />
      </>
    )}
    {category === 'fashion_craft' && (
      <>
        <path d="m7 25 14-14M19 7l6 6M17 9l6 6M6 27l-1-1 3-3 1 1-3 3Z" />
        <path d="M22 6c4 0 5 3 3 5M8 23c-2-3-1-6 1-8" />
        <circle cx="23.5" cy="8.5" r=".8" />
      </>
    )}
    {category === 'product_design' && (
      <>
        <path d="m16 4 11 6v12l-11 6-11-6V10l11-6Z" />
        <path d="m5.5 10 10.5 6 10.5-6M16 16v12M10 7.5l11 6" />
      </>
    )}
  </svg>
</span>

<style>
  .category-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
