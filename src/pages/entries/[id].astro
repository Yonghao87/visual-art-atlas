---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Visual from '../../components/Visual.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getEntries } from '../../lib/entries';
import { relatedEntries } from '../../lib/visibility';
import { path } from '../../lib/paths';
import { categories, topicTypes } from '../../constants/taxonomy';
import type { Entry } from '../../lib/schema';
export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      issue: entries.length - i,
      previous: entries[i + 1] ?? null,
      next: entries[i - 1] ?? null,
      related: relatedEntries(entry, entries),
    },
  }));
}
interface Props {
  entry: Entry;
  issue: number;
  previous: Entry | null;
  next: Entry | null;
  related: Entry[];
}
const { entry: e, issue, previous, next, related } = Astro.props;
const c = categories[e.category];
---

<BaseLayout
  title={e.title}
  description={e.summary}
  image={e.cover?.src ?? '/images/share.png'}
>
  <article class="entry-detail shell">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href={path('/explore/')}>探索图鉴</a>
      <span aria-hidden="true">/</span>
      <a href={path(`/explore/?category=${e.category}`)}>{c.label}</a>
      <span aria-hidden="true">/</span>
      <span>档案 {String(issue).padStart(3, '0')}</span>
    </nav>
    <header class="entry-header">
      <div class="eyebrow">
        ARCHIVE № {String(issue).padStart(3, '0')}{' '}
        <span> / {c.english.toUpperCase()}</span>
      </div>
      <h1>{e.title}</h1>
      <p class="entry-subtitle">{e.subtitle}</p>
      <div class="entry-metadata">
        <time datetime={e.date}>{e.date.replaceAll('-', '.')}</time>
        <span>{topicTypes[e.topicType]}</span>
        {e.period && <span>{e.period}</span>}
        <span>{e.regions.join(' / ')}</span>
      </div>
      <div class="detail-tags">
        {e.tags.map((t) => (
          <a href={path(`/explore/?tag=${encodeURIComponent(t)}`)}>{t}</a>
        ))}
      </div>
    </header>
    <figure class="entry-cover">
      <Visual entry={e} priority detail />
      <figcaption>
        {e.cover?.src ? (
          <>
            <span>
              {e.cover.credit} ·{' '}
              {e.cover.rights === 'public_domain' ? '公共领域' : '获准使用'}
            </span>
            <a
              href={e.cover.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              查看原始来源 ↗
            </a>
          </>
        ) : (
          <span>本站排版封面 · 用于主题导览，不是作品原图</span>
        )}
      </figcaption>
    </figure>
    <div class="reading-layout">
      <aside class="entry-toc">
        <span class="eyebrow">IN THIS STUDY</span>
        <nav aria-label="档案目录">
          <a href="#context">01 认识与语境</a>
          <a href="#visual-language">02 视觉语言</a>
          <a href="#works">03 作品与研究实例</a>
          <a href="#applications">04 设计转化</a>
          <a href="#sources">05 参考来源</a>
        </nav>
        <button class="copy-link" id="copy-link">
          复制档案链接 ↗
        </button>
        <span id="copy-status" role="status" class="small-note"></span>
      </aside>
      <div class="reading-content">
        <section id="context">
          <div class="eyebrow">01 / CONTEXT</div>
          <h2>一句话认识</h2>
          <p class="summary-callout">{e.summary}</p>
          <h3>背景与语境</h3>
          {e.context.split('\n\n').map((p) => (
            <p>{p}</p>
          ))}
          {e.people.length > 0 && (
            <div class="people-list">
              {e.people.map((p) => (
                <div>
                  <strong>{p.name}</strong>
                  <span>{p.role}</span>
                </div>
              ))}
            </div>
          )}
        </section>
        <section id="visual-language">
          <div class="eyebrow">
            02 / VISUAL LANGUAGE <span>· 本站分析</span>
          </div>
          <h2>看见画面里的秩序。</h2>
          <div class="feature-list">
            {e.visualFeatures.map((f, i) => (
              <div class="feature-item">
                <span class="feature-index serif">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{f.label}</h3>
                  <p>{f.description}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
        <section id="works">
          <div class="eyebrow">03 / REFERENCES</div>
          <h2>作品与研究实例</h2>
          <p class="section-note">
            年代对应下列来源记录；不同版本可能存在差异。技法类档案使用明确标注的研究实例。
          </p>
          <div class="work-grid">
            {e.works.map((w) => (
              <figure class="work-item">
                {w.image?.src &&
                !['unknown', 'link_only'].includes(w.image.rights) ? (
                  <div class="visual work-visual">
                    <div class="work-placeholder">
                      <span class="serif">↗</span>
                      <span>图片暂时无法显示</span>
                    </div>
                    <img
                      src={path(w.image.src)}
                      alt={w.image.alt}
                      width="900"
                      height="700"
                      loading="lazy"
                      data-art-image
                    />
                  </div>
                ) : (
                  <div class="work-placeholder">
                    <span class="serif">
                      {w.title.split(' / ')[0].slice(0, 1)}
                    </span>
                    <span>作品图未收录 · 前往原站观看</span>
                  </div>
                )}
                <figcaption>
                  <h3>{w.title}</h3>
                  <p>
                    {w.creator}
                    <br />
                    {w.year ?? '来源未注明年代'}
                  </p>
                  {w.sourceUrl && (
                    <a
                      class="text-link"
                      href={w.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      原始来源 ↗
                    </a>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
        {e.comparison && (
          <section class="comparison">
            <div class="eyebrow">SIDE BY SIDE / 本站分析</div>
            <h2>与「{e.comparison.target}」比较</h2>
            <p>{e.comparison.description}</p>
          </section>
        )}
        <section id="applications">
          <div class="eyebrow">
            04 / INTO PRACTICE <span>· 本站创作建议</span>
          </div>
          <h2>把观看，转化为创作。</h2>
          <ol class="applications">
            {e.applications.map((a) => (
              <li>{a}</li>
            ))}
          </ol>
          {e.experiment && (
            <div class="experiment">
              <span class="eyebrow">A SMALL EXPERIMENT</span>
              <h3>今日创作实验</h3>
              <p>{e.experiment}</p>
              <span class="small-note">
                纸笔或数字工具都可以，从一个小练习开始。
              </span>
            </div>
          )}
        </section>
        <section id="sources">
          <div class="eyebrow">05 / SOURCES</div>
          <h2>每一份档案，都有出处。</h2>
          <ol class="source-list">
            {e.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.title} ↗
                </a>
                <span>
                  {s.publisher} · 核验 {s.verifiedAt ?? '尚未核验'}
                </span>
                <p>{s.verificationNote ?? '示例来源'}</p>
              </li>
            ))}
          </ol>
          <p class="section-note">
            史实依据上述来源自行概括；视觉语言、比较与应用为本站分析。图片权利独立于作品信息，未确认展示许可的图像只提供链接。
          </p>
          {e.nextTopics.length > 0 && (
            <p class="next-topics">
              继续研究的方向：{e.nextTopics.join(' / ')}
            </p>
          )}
        </section>
      </div>
    </div>
    <nav class="entry-pagination" aria-label="相邻档案">
      {previous ? (
        <a href={path(`/entries/${previous.id}/`)}>
          <span>← 上一份档案</span>
          <strong>{previous.title}</strong>
        </a>
      ) : (
        <div>
          <span>已到第一份档案</span>
        </div>
      )}
      {next ? (
        <a href={path(`/entries/${next.id}/`)}>
          <span>下一份档案 →</span>
          <strong>{next.title}</strong>
        </a>
      ) : (
        <div>
          <span>已到最新档案</span>
          <a href={path('/explore/')}>返回探索 →</a>
        </div>
      )}
    </nav>
  </article>
  <section class="related-section shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow">KEEP YOUR EYES OPEN</span>
        <h2>灵感之间，还有关联。</h2>
      </div>
      <a class="text-link" data-random href={path('/explore/')}>
        随机探索 ↗
      </a>
    </div>
    <div class="entry-grid related-grid">
      {related.map((e) => (
        <EntryCard entry={e} />
      ))}
    </div>
  </section>
  <script>
    document
      .getElementById('copy-link')
      ?.addEventListener('click', async () => {
        const status = document.getElementById('copy-status')!;
        try {
          await navigator.clipboard.writeText(location.href);
          status.textContent = '链接已复制';
        } catch {
          status.textContent = '请从浏览器地址栏复制链接';
        }
      });
  </script>
</BaseLayout>
