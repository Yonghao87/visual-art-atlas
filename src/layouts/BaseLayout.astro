---
import '../styles/global.css';
import { path } from '../lib/paths';
import { getEntries, demoMode } from '../lib/entries';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = '每天认识一种新的视觉语言',
  description = 'Visual Art Atlas 视觉艺术图鉴：探索绘画、设计、建筑与创作之间的关联。按视觉语言检索，打开每一份可追溯的艺术档案。',
  image = '/images/share.png',
} = Astro.props;
const current = Astro.url.pathname;
const entries = await getEntries();
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
  .href;
const social = new URL(path(image), Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} · Visual Art Atlas</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />
    <meta name="theme-color" content="#f6f4ee" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Visual Art Atlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={social} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <header class="site-header shell">
      <a class="brand" href={path('/')} aria-label="Visual Art Atlas 首页">
        <span class="brand-mark" aria-hidden="true">
          va<span>²</span>
        </span>
        <span>
          Visual Art Atlas<small>视觉艺术图鉴</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a
          href={path('/explore/')}
          aria-current={current.includes('/explore/') ? 'page' : undefined}
        >
          探索图鉴
        </a>
        <a href={path('/explore/?edition=family')}>亲子共读</a>
        <a class="nav-categories" href={path('/#categories')}>七大领域</a>
        <a
          href={path('/about/')}
          aria-current={current.includes('/about/') ? 'page' : undefined}
        >
          关于
        </a>
        <a
          class="nav-search"
          href={path('/explore/#search')}
          aria-label="搜索艺术档案"
        >
          ⌕
        </a>
      </nav>
    </header>
    {demoMode && (
      <div class="demo-notice">
        DEMO 模式：带有“示例”标记的内容尚未核验，不属于正式档案。
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-brand" href={path('/')}>
          Visual Art Atlas<span>视觉艺术图鉴</span>
        </a>
        <p>保持好奇，持续观看。</p>
      </div>
      <div class="footer-links">
        <a href={path('/about/')}>内容方法与版权</a>
        <a href={path('/catalog.json')}>开放目录 JSON ↗</a>
        <span>© 2026 · 一座持续生长的视觉档案馆</span>
      </div>
    </footer>
    <script
      id="random-index"
      type="application/json"
      set:html={JSON.stringify(
        entries.map((e) => path(`/entries/${e.id}/`)),
      ).replaceAll('<', '\\u003c')}
    />
    <script>
      const random = JSON.parse(
        document.getElementById('random-index')?.textContent ?? '[]',
      ) as string[];
      document
        .querySelectorAll<HTMLAnchorElement>('[data-random]')
        .forEach((el) =>
          el.addEventListener('click', (event) => {
            if (random.length) {
              event.preventDefault();
              window.location.assign(
                random[Math.floor(Math.random() * random.length)]!,
              );
            }
          }),
        );
      document
        .querySelectorAll<HTMLImageElement>('[data-art-image]')
        .forEach((img) => {
          const failed = () => {
            img.hidden = true;
            img.closest('.visual')?.classList.add('image-failed');
          };
          img.addEventListener('error', failed);
          if (img.complete && !img.naturalWidth) failed();
        });
    </script>
  </body>
</html>
